# Local development uses SQLite by default. For hosting, use a Postgres URL (for example from Neon).
DATABASE_URL=sqlite:///./civictrack.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
# Needed only if the frontend is served from a different address than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo records load only when backend/data/seed_data.json is missing. Use false in production.
SEED_DEMO=true
# Leave EMPTY in production. If set, POST /api/admin/reset-demo wipes all data and reloads the baseline.
ADMIN_RESET_KEY=
DEMO_LOGIN=true
SERVICE_BBOX=12.70,79.90,13.45,80.50
