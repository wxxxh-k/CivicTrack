# SQLite locally (default). Use a Postgres URL when deployed.
DATABASE_URL=sqlite:///./civictrack.db
# DATABASE_URL=postgresql://user:password@host:5432/civictrack
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to enable POST /api/admin/reset-demo (send it as the X-Admin-Key header)
ADMIN_RESET_KEY=
# Demo sign-in for judges. Set to false for a real deployment.
DEMO_LOGIN=true
